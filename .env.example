# QuantLedger backend — copy to .env and adjust for local dev
# Requires: pip install python-dotenv

# JWT / auth (use a long random string in production)
SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (SQLite default; use postgres://... when you scale)
DATABASE_URL=sqlite:///./finance.db

# Comma-separated origins for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional — market data / LLM integrations (future)
# ALPHA_VANTAGE_API_KEY=
# FINNHUB_API_KEY=
# OPENAI_API_KEY=
